#!/bin/sh
# Cinematic's checks before every commit: luacheck, the TOC check and the
# offline check (the addon loaded outside the game on both clients, which also
# catches a file over Lua's 200-local cap), and a staged fix card's matrix
# tests (Tools/audit.py, the /audit skill; commit-msg checks the message's
# expectation OKs and risk note). They run on what is being
# committed (the index, a temporary one too), copied to a scratch folder, so
# another session's unfinished edits in the working tree don't block a commit.
#
# On once per clone: git config core.hooksPath Tools/hooks
# Skipped only when the user asks: CINE_SKIP_CHECKS=1 git commit ...

[ -n "$CINE_SKIP_CHECKS" ] && { echo "pre-commit: checks skipped (CINE_SKIP_CHECKS)"; exit 0; }

root=$(git rev-parse --show-toplevel) || exit 1
# (HEAD as the checks start: commit-msg refuses the commit if another
# session's commit lands meanwhile, as this index would undo it.)
_py=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
[ -n "$_py" ] && [ -f "$root/Tools/audit.py" ] && (cd "$root" && "$_py" -I Tools/audit.py mark)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/cine-precommit.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT

# (What's staged, not the working tree. GIT_INDEX_FILE, when a commit uses a
# temporary index, is honoured by both commands.)
git ls-files -z -- '*.lua' '*.toc' '*.xml' .luacheckrc .pkgmeta 'Tools/*.py' 'Tools/offline/*' 'Fonts/*' \
	| (cd "$root" && xargs -0 git checkout-index --prefix="$tmp/" --) || { echo "pre-commit: couldn't copy the staged files"; exit 1; }

luacheck=$(command -v luacheck 2>/dev/null || command -v luacheck.exe 2>/dev/null)
[ -z "$luacheck" ] && [ -x "$HOME/bin/luacheck.exe" ] && luacheck="$HOME/bin/luacheck.exe"
[ -z "$luacheck" ] && [ -x "$HOME/bin/luacheck" ] && luacheck="$HOME/bin/luacheck"
python=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)

failed=0
cd "$tmp" || exit 1
if [ -n "$luacheck" ]; then
	"$luacheck" . -q --no-color || failed=1
else
	echo "pre-commit: luacheck not found, skipped"
fi
if [ -n "$python" ]; then
	if [ -f Tools/check-toc.py ]; then "$python" -I Tools/check-toc.py || failed=1; fi
	# (A kit test named like an older /cine debug command never runs.)
	if [ -f Tools/kit-names.py ]; then "$python" -I Tools/kit-names.py || failed=1; fi
	# (A local function called above its own line calls a nil global; luacheck
	# misses it when the name is also a known global. known.lua:
	# lua-local-before-defined.)
	if [ -n "$luacheck" ] && [ -f Tools/errors/forwardlocal.py ]; then
		"$python" -I Tools/errors/forwardlocal.py "$luacheck" || failed=1
	fi
	# (Known errors' don'ts: code doing what a traced error says never to do,
	# Tools/errors/known.lua. Not a git checkout here, so it walks the files.)
	if [ -f Tools/errors/errors.py ]; then
		"$python" -I Tools/errors/errors.py selftest >/dev/null || { "$python" -I Tools/errors/errors.py selftest; failed=1; }
		"$python" -I Tools/errors/errors.py check . || failed=1
	fi
	if command -v lua5.1 >/dev/null 2>&1; then
		lua5.1 Tools/offline/check.lua || failed=1
	else
		"$python" -I Tools/offline/run.py Tools/offline/check.lua || failed=1
	fi
	# (A staged fix card, Tools/audits: its matrices on HEAD's code and on
	# what's staged; a changed cell the card doesn't declare fails. Run from
	# the repo for git, on the staged copy here.)
	if [ -f Tools/audit.py ]; then
		(cd "$root" && "$python" -I Tools/audit.py precommit "$tmp") || failed=1
	fi
else
	echo "pre-commit: python not found, TOC and offline checks skipped"
fi

if [ "$failed" != 0 ]; then
	echo "pre-commit: checks failed, nothing committed. Fix the above and commit again."
	exit 1
fi
