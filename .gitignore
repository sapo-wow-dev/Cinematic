Tools/tests/logs/

# Discord threads saved for Claude (Tools/discord-bug-bot/claude_desk.py): players' posts and files
Tools/discord-inbox/

# Profiler recordings and reports (Tools/perf/analyze.py): game data from this PC
Tools/perf/history/
Tools/perf/reports/
