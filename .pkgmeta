package-as: Cinematic

ignore:
  - .luacheckrc
  - Media
  - Release
  - .gitignore
  - CinematicDev.toc
  - Tools
  - docs
  - .claude
  # (Wind Guide: a demo, in the dev copy only, CinematicDev.toc)
  - WindGuide.lua
  - WindGuideStyles.lua
  - Textures/WindGuide
  # (Portal scout: /cine debug portal, trying the game's portal models, dev copy only)
  - PortalScout.lua
  # (Shoulder Cam test: /cine debug shoulder, dev copy only)
  - ShoulderCamTest.lua
  # (Screen effects: /cine debug screenfx, the game's full-screen effects animated, dev copy only;
  # ScreenEffectsData.lua and ScreenEffects.lua ship: Vitals Vision's game effects)
  - ScreenEffectScout.lua
  # (Tint layer test: /cine debug tintlayer, where a wash sits under nameplates, dev copy only)
  - TintLayerTest.lua
  # (Mouse Turn cap: right-click turning speed cap, dev copy only)
  - MouseTurn.lua
  # (Demo Hub: demo tools and recording scripts, in the dev copy only)
  - DemoHub.lua
  # (Bar hover test: /cine debug bartest, action bar addons' fade, hover and clicks, dev copy only)
  - BarHoverTest.lua
  - LowManaTest.lua
  # (Health & Resources test: /cine debug hrtest, dev copy only)
  - ThresholdTest.lua
  # (Nameplate width test: /cine debug platewidth, dev copy only)
  - PlateWidthTest.lua
  # (Damage Vision meter crossfade test: /cine debug dvmeter, dev copy only)
  - DamageVisionMeterTest.lua
  # (Spoken support test: /cine debug spokentest, dev copy only)
  - SpokenTest.lua
  # (Minimap Copy: the Dev hub page drawing the minimap from the game's own tiles, dev copy only)
  - MinimapTiles.lua
  - MinimapCopy.lua
  # (Cursor Hide: test pictures for /cine debug cursorsize pic, not shipped)
  - Textures/CursorTestSmall.tga
  - Textures/CursorTestRed.tga
  # (Vitals Vision's old sprites: only make_wind_guide.py reads them now)
  - Textures/LowHealth/Effects.tga
